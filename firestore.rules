
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "bYupM4WnvPQoF7Dv4Xtxvc2INLg1";
    }

    function hasOnlyProfileFields(data) {
      return data.keys().hasAll([
        "email", "matkhau", "hoten", "hinhanh"
      ])
      && data.keys().hasOnly([
        "email", "matkhau", "hoten", "hinhanh"
      ]);
    }

    function isValidProfile(data) {
      return hasOnlyProfileFields(data)
        && data.email is string
        && data.hoten is string
        && data.matkhau == "Đã ẩn"
        && data.hinhanh is string
        && data.hinhanh.size() <= 900000;
    }

    match /users/{userId} {
      allow read, delete: if isAdmin();

      allow create, update: if isAdmin()
        && isValidProfile(request.resource.data);
    }
  }
}
