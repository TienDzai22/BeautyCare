{
  "expo": {
    "name": "BeautyCare Admin",
    "slug": "beautycare-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "beautycare",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.beautycare.admin",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8FA"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "BeautyCare cần quyền truy cập ảnh để chọn ảnh đại diện khách hàng."
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
